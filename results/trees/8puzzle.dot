  subgraph cluster_legend { label="Legjenda"; fontsize=11; color="#DADCE0"; style=rounded;
    lg_expanded [label="e zgjeruar (#rendi)", fillcolor="#E8F0FE", color="#3B6FD8"];
    lg_goal [label="qëllimi", fillcolor="#D7F5DD", color="#1E8E3E", penwidth="2.5"];
